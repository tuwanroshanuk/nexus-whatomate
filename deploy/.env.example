TZ=Asia/Colombo

WHATOMATE_APP__NAME=Nexus WhatsApp
WHATOMATE_APP__ENCRYPTION_KEY=CHANGE_ME_64_CHAR_ENCRYPTION_KEY

POSTGRES_USER=whatomate
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=whatomate

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

WHATOMATE_JWT__SECRET=CHANGE_ME_64_CHAR_JWT_SECRET

WHATOMATE_WHATSAPP__WEBHOOK_VERIFY_TOKEN=CHANGE_ME_WEBHOOK_VERIFY_TOKEN
WHATOMATE_WHATSAPP__API_VERSION=v24.0
WHATOMATE_WHATSAPP__APP_ID=
WHATOMATE_WHATSAPP__APP_SECRET=
WHATOMATE_WHATSAPP__CONFIG_ID=

# Server-side Firebase Cloud Messaging for Android background/killed incoming calls.
# Project ID plus a Firebase service-account JSON are required on the running
# Whatomate server. Keep credentials in Dokploy's protected environment values.
WHATOMATE_FIREBASE_PROJECT_ID=
WHATOMATE_FIREBASE_CREDENTIALS_JSON=
# Optional alternative to CREDENTIALS_JSON when a credentials file is mounted:
WHATOMATE_FIREBASE_CREDENTIALS_FILE=

WHATOMATE_DEFAULT_ADMIN__EMAIL=admin@nexuscloud.uk
WHATOMATE_DEFAULT_ADMIN__PASSWORD=CHANGE_ME_ADMIN_PASSWORD
WHATOMATE_DEFAULT_ADMIN__FULL_NAME=Nexus Administrator
